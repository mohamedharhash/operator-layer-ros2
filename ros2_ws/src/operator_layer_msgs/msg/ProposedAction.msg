# What a policy / planner / VLA wants the robot to do next.
std_msgs/Header header
string action_id          # unique id, generated by the proposer
string source             # e.g. "act_policy_v3", "teleop", "scripted"
string action_type        # move_joints | move_ee | gripper | pick_place
float64[] target          # meaning depends on action_type (joint rad, or x y z yaw in m/rad)
string context_json       # scene info the sim needs (object pose, etc.), JSON-encoded
